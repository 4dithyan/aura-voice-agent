OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# Model roles
FAST_MODEL=qwen2.5:1.5b
VISION_MODEL=qwen3-vl:4b

# Voice
WHISPER_MODEL=tiny
TTS_ENABLED=true
PIPER_MODEL_PATH=d:/AI Projects/Voice agent/models/piper/en_US-lessac-medium.onnx
WAKE_WORD_ENABLED=true
WAKE_WORD=hey,hello

# Safety
LOG_COMMANDS=true
CONFIRM_DANGEROUS_ACTIONS=true
CONFIRM_PURCHASES=true

# Vision
VISION_ENABLED=true
VISION_ON_FAILURE=true
VISION_MIN_CONFIDENCE=0.80

# Browser
BROWSER_HEADLESS=false

# Task limits
MAX_ACTION_RETRIES=2
MAX_TASK_STEPS=30
MAX_CONTEXT_ITEMS=8
MAX_SCREENSHOT_CACHE=5
MAX_ACTION_HISTORY=20

# Performance
LOW_RESOURCE_MODE=true
